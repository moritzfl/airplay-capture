{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle\\/libs\\.versions\\.toml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\\s]+)\\s+[^=]+ = \"(?<currentValue>[^\"]+)\""]
    }
  ],
  "packageRules": [
    {
      "description": "The Docker JDK must match the Gradle toolchain. Raise the Java major together in both Dockerfiles and the Gradle toolchain.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
